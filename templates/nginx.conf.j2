events {
    worker_connections 1024;
}
http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # HTTP server block for port {{ nginx_port_http }}
    server {
        listen {{ nginx_port_http }};
        server_name {{ nginx_server_name }};
        
        location /.well-known/acme-challenge/ {
            root {{ nginx_html_root }};
            try_files $uri =404;
        }
        
        # Redirect all other HTTP traffic to HTTPS
        location / {
            return 301 https://$host$request_uri;
        }
    }
    
    # HTTPS server block for port {{ nginx_port_https }}
    server {
        listen {{ nginx_port_https }} ssl;
        server_name {{ nginx_server_name }};
        
        ssl_certificate {{ nginx_ssl_dir }}/{{ nginx_ssl_cert }};
        ssl_certificate_key {{ nginx_ssl_dir }}/{{ nginx_ssl_key }};
        
        # SSL settings
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;
        ssl_ciphers "EECDH+AESGCM:EDH+AESGCM";
        ssl_session_cache shared:SSL:10m;
        
        location / {
            root {{ nginx_html_root }};
            index index.html;
        }
    }
}
